{
  "name": "anyway-design",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/node": "^26.2.0",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.3",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "build:docs": "bun run --cwd apps/docs build",
    "build:md": "bun run --cwd apps/md build",
    "build:plan": "bun run --cwd apps/plan build",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "deploy": "turbo run deploy -F @anyway-design/infra --",
    "deploy:plan": "bun run --cwd apps/plan deploy",
    "destroy": "turbo run destroy -F @anyway-design/infra --",
    "dev": "turbo run dev",
    "dev:docs": "bun run --cwd apps/docs dev",
    "dev:macos": "bun run --cwd apps/macos-lab dev",
    "dev:md": "bun run --cwd apps/md dev",
    "dev:plan": "bun run --cwd apps/plan dev",
    "dev:web": "turbo run dev -F web --",
    "fix": "ultracite fix",
    "test:md": "bun run --cwd apps/md test",
    "test:plan": "bun run --cwd apps/plan test",
    "dev:platform": "bun run --cwd apps/platform dev",
    "build:platform": "turbo run build --filter=platform",
    "test:platform": "bun run --cwd apps/platform test"
  },
  "dependencies": {
    "@anyway-design/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@anyway-design/config": "workspace:*",
    "@biomejs/biome": "2.5.9",
    "@cloudflare/workers-types": "^5.20260728.1",
    "@types/node": "catalog:",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "7.10.7"
  },
  "packageManager": "bun@1.3.13"
}
