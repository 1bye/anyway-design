{
  "name": "@1bye/macos",
  "version": "0.1.0",
  "description": "Experimental React components inspired by macOS Tahoe and Sequoia.",
  "keywords": [
    "react",
    "macos",
    "tahoe",
    "components"
  ],
  "homepage": "https://platform.anyway.design",
  "bugs": {
    "url": "https://github.com/1bye/anyway-design/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1bye/anyway-design.git",
    "directory": "packages/macos"
  },
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    "./styles.css": "./dist/styles.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "prepack": "bun run build",
    "test": "bun test tests",
    "test:release": "node scripts/test-release.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
